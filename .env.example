# --- Firebase client (sign-in only) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — never expose) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key with \n line breaks.
FIREBASE_PRIVATE_KEY=

# The ONLY account allowed to use the dashboard.
SUPER_ADMIN_EMAIL=

# Secret for signing tracked links (/r/<token>). 32+ random characters.
# Generate one with: openssl rand -base64 48
LINK_TRACKING_SECRET=

# Protects /api/cron/funnel. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Public base URL of this deployment (used to build tracked links), e.g. https://your-app.vercel.app
APP_URL=

# --- WhatsApp Cloud API (server only — never NEXT_PUBLIC_) ---
# System User access token with whatsapp_business_messaging + whatsapp_business_management.
# Shared by every workspace whose WhatsApp Business Account is in the same Meta Business.
# Phone Number ID and WABA ID are NOT env vars: they are set per workspace in the dashboard.
WHATSAPP_ACCESS_TOKEN=
# Graph API version, e.g. v23.0 (defaults to v23.0 if unset or invalid).
META_API_VERSION=
# Phase 3 (webhooks) — not used yet:
# META_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
