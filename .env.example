# --- Firebase client (sign-in only) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — never expose) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key with \n line breaks.
FIREBASE_PRIVATE_KEY=

# The ONLY account allowed to use the dashboard.
SUPER_ADMIN_EMAIL=

# Secret for signing tracked links (/r/<token>). 32+ random characters.
# Generate one with: openssl rand -base64 48
LINK_TRACKING_SECRET=

# Protects /api/cron/funnel. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Public base URL of this deployment (used to build tracked links), e.g. https://your-app.vercel.app
APP_URL=
